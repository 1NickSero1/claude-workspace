    {
      "id": "9b6c7bb0-11f9-49a4-8787-c1b89a04112c",
      "name": "Armar recordatorio diario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst hoy = new Date().toISOString().slice(0, 10);\nconst agenda = items.filter(i => i.json._source === 'agenda' && i.json.fecha === hoy);\nconst habitosHoy = items.filter(i => i.json._source === 'habitos' && i.json.fecha === hoy);\n\nconst lineas = [`Buenos dias, Nico. Hoy ${hoy}:`];\n\nif (agenda.length) {\n  lineas.push('', 'Agenda de hoy:');\n  for (const a of agenda) {\n    const hora = a.json.hora ? `${a.json.hora} - ` : '';\n    lineas.push(`- ${hora}${a.json.descripcion}`);\n  }\n} else {\n  lineas.push('', 'No tienes nada agendado para hoy.');\n}\n\nif (habitosHoy.length) {\n  lineas.push('', 'Habitos ya registrados hoy:');\n  for (const h of habitosHoy) {\n    lineas.push(`- ${h.json.nombre}: ${h.json.hecho ? 'hecho' : 'pendiente'}`);\n  }\n} else {\n  lineas.push('', 'Todavia no registras habitos hoy -- escribeme cuando hagas alguno.');\n}\n\nreturn [{ json: { mensaje: lineas.join('\\n') } }];"
      }
    },
