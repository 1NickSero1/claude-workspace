    {
      "id": "6029e580-f44a-4b7b-9acd-599fa980f4f6",
      "name": "Calcular resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst by = {ingresos: [], gastos: [], deudas: [], ahorro: [], compras: []};\nfor (const it of items) {\n  const s = it.json._source;\n  if (by[s]) by[s].push(it.json);\n}\n\nfunction num(v) {\n  const n = parseFloat(v);\n  return isNaN(n) ? 0 : n;\n}\n\nfunction fmt(n) {\n  const sign = n < 0 ? '-' : '';\n  return sign + '$' + Math.round(Math.abs(n)).toLocaleString('es-CO');\n}\n\nconst totalIngresos = by.ingresos.reduce((s, r) => s + num(r.monto), 0);\n\nconst gastos = by.gastos;\nconst totalGastos = gastos.reduce((s, r) => s + num(r.monto), 0);\nconst gastosPagados = gastos\n  .filter(r => (r.estado || '').toString().toLowerCase() === 'pagado')\n  .reduce((s, r) => s + num(r.monto), 0);\nconst gastosPendientes = totalGastos - gastosPagados;\n\nconst comprasPorDeuda = {};\nfor (const c of by.compras) {\n  const k = c.deuda;\n  comprasPorDeuda[k] = (comprasPorDeuda[k] || 0) + num(c.monto);\n}\n\nlet deudaConocida = 0;\nlet totalAbonos = 0;\nconst deudaLineas = [];\nfor (const d of by.deudas) {\n  const abonado = num(d.abonado);\n  totalAbonos += abonado;\n  const compras = comprasPorDeuda[d.nombre] || 0;\n  const sinTotal = d.total_base === '' || d.total_base === null || d.total_base === undefined;\n  if (sinTotal) {\n    deudaLineas.push(`- ${d.nombre}: por confirmar` + (abonado ? ` (abonado ${fmt(abonado)})` : ''));\n  } else {\n    const total = num(d.total_base) + compras;\n    const pendiente = Math.max(total - abonado, 0);\n    deudaConocida += pendiente;\n    deudaLineas.push(`- ${d.nombre}: ${fmt(pendiente)} de ${fmt(total)}`);\n  }\n}\n\nconst teQuedaAhora = totalIngresos - gastosPagados - totalAbonos;\nconst ahorro = by.ahorro[0] || {};\n\nconst mensaje = [\n  `Resumen`,\n  `Ingresos: ${fmt(totalIngresos)}`,\n  `Gastos fijos: ${fmt(totalGastos)} (${fmt(gastosPagados)} pagado, ${fmt(gastosPendientes)} pendiente)`,\n  `Te queda ahora: ${fmt(teQuedaAhora)}`,\n  `Deuda activa conocida: ${fmt(deudaConocida)}`,\n  ...deudaLineas,\n  `Ahorro ${ahorro.meta || ''}: ${fmt(num(ahorro.guardado))}`,\n].join('\\n');\n\nreturn [{ json: { mensaje } }];"
      }
    },
    {
      "id": "941f8afc-9c6a-40bd-907b-391e23d40ce2",
      "name": "Nota: Sub-workflow reusabl",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        520
      ],
      "parameters": {
        "content": "Sub-workflow reusable: lo invoca inbound-mensaje.json cuando el intent es 'pedir_resumen', y tambien lo puedes llamar desde un Cron si quieres un resumen quincenal automatico. Devuelve un solo campo 'mensaje' con el texto final listo para mandar por WhatsApp.",
        "height": 160,
        "width": 500
      }
    }
