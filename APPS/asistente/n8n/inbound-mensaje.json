    {
      "id": "d2e75a9f-3a4a-41b0-b86e-fb6000253f3a",
      "name": "Buscar pendiente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        -450
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const claude = $('Parsear respuesta Claude').item.json;\nconst buscar = (claude.data.descripcion_buscar || '').toLowerCase();\nconst rows = $input.all();\nlet best = null, bestScore = 0;\nfor (const r of rows) {\n  if ((r.json.estado || '').toLowerCase() === 'hecho') continue;\n  const desc = (r.json.descripcion || '').toLowerCase();\n  if (desc && (desc.includes(buscar) || buscar.includes(desc))) {\n    if (desc.length > bestScore) { best = r.json; bestScore = desc.length; }\n  }\n}\nif (!best) return [{ json: { encontrado: false, id: '__none__' } }];\nreturn [{ json: { id: best.id, encontrado: true } }];"
      }
    },
