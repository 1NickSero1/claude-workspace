        1600,
        550
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const claude = $('Parsear respuesta Claude').item.json;\nconst deudaNombre = (claude.data.deuda || '').toLowerCase();\nconst rows = $input.all();\nconst match = rows.find(r => (r.json.nombre || '').toLowerCase() === deudaNombre);\nif (!match) return [{ json: { encontrado: false, nombre: '__none__' } }];\nconst abonoNuevo = parseFloat(claude.data.monto) || 0;\nconst abonadoActual = parseFloat(match.json.abonado) || 0;\nreturn [{ json: { nombre: match.json.nombre, abonado: abonadoActual + abonoNuevo, encontrado: true } }];"
      }
    },
