    {
      "id": "df3848b0-283b-41a0-a3cf-161f2b723b6d",
      "name": "Extraer mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json;\nlet value = j;\nif (j.body && j.body.entry) value = j.body.entry[0].changes[0].value;\nelse if (j.entry) value = j.entry[0].changes[0].value;\nconst message = (value.messages && value.messages[0]) || value.message || {};\nconst texto = (message.text && message.text.body) || message.body || j.text || '';\nconst from = message.from || j.from || '';\nconst fecha_hoy = new Date().toISOString().slice(0, 10);\nreturn [{ json: { texto, from, fecha_hoy } }];"
      }
    },
    {
      "id": "d59e678a-2a1c-4a28-aa9d-1de6d182bd1f",
      "name": "Preparar prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first().json;\nitem.systemPrompt = 'Eres el asistente personal de Nico. Te escribe por WhatsApp mensajes cortos, informales, a veces sin tildes ni mayusculas, a veces con errores de escritura. Tu unico trabajo es leer el mensaje y devolver un objeto JSON, y nada mas -- sin texto antes, sin texto despues, sin bloque de codigo markdown alrededor.\\n\\nFormato exacto de salida:\\n{\"intent\": \"agregar_pendiente | completar_pendiente | registrar_habito | agregar_evento | marcar_gasto | agregar_abono | agregar_compra | pedir_resumen | conversacion_libre\", \"data\": {}, \"reply\": \"texto breve en espanol, tono cercano, para responder por WhatsApp\"}\\n\\nReglas generales:\\n- Fechas siempre en formato YYYY-MM-DD. Si el usuario no da fecha, usa la fecha de hoy (te la doy en el mensaje del usuario como fecha_hoy).\\n- Montos de dinero siempre como numero entero en pesos colombianos, sin puntos ni signos (ej. \"50 mil\" -> 50000, \"50k\" -> 50000, \"$1.300.000\" -> 1300000).\\n- Si el mensaje no da suficiente informacion para completar un campo obligatorio, usa intent \"conversacion_libre\" y en reply pregunta exactamente lo que falta -- nunca inventes un dato.\\n- reply va siempre en espanol, corto (1-2 frases), sin emojis salvo que el mensaje del usuario los use primero.\\n- Si el mensaje es un saludo, una pregunta general, o no encaja en ninguna intencion de abajo, usa intent \"conversacion_libre\" y responde de forma natural y breve.\\n\\nIntenciones y su data:\\n\\nagregar_pendiente -- el usuario quiere anotar algo por hacer.\\ndata: {\"descripcion\": string, \"categoria\": string opcional default \"personal\", \"fecha_vencimiento\": string o null}\\n\\ncompletar_pendiente -- el usuario dice que ya hizo algo de su lista.\\ndata: {\"descripcion_buscar\": string}\\n\\nregistrar_habito -- el usuario reporta un habito de hoy (hecho o no hecho).\\ndata: {\"nombre\": string, \"hecho\": true o false}\\n\\nagregar_evento -- el usuario quiere agendar algo en una fecha/hora.\\ndata: {\"fecha\": string, \"hora\": string o null, \"descripcion\": string, \"recordar_antes_min\": number o null}\\n\\nmarcar_gasto -- el usuario dice que ya pago (o no) un gasto fijo quincenal existente (arriendo, spotify, internet, etc).\\ndata: {\"descripcion_buscar\": string, \"estado\": \"pagado\"}\\n\\nagregar_abono -- el usuario abono plata a una deuda (Sofi, Mama, Rappi).\\ndata: {\"deuda\": string, \"monto\": number}\\n\\nagregar_compra -- el usuario hizo una compra con la tarjeta (Rappi) que se suma a la deuda.\\ndata: {\"deuda\": \"Rappi\", \"descripcion\": string, \"monto\": number}\\n\\npedir_resumen -- el usuario pregunta como va de plata, pendientes, o habitos.\\ndata: {\"tipo\": \"gastos\" | \"pendientes\" | \"habitos\"}\\n\\nconversacion_libre -- cualquier otra cosa.\\ndata: {}\\n\\nEjemplos:\\n\\nUsuario: \"agregame pagar el internet antes del 25\"\\n{\"intent\":\"agregar_pendiente\",\"data\":{\"descripcion\":\"Pagar el internet\",\"categoria\":\"casa\",\"fecha_vencimiento\":\"2026-08-25\"},\"reply\":\"Anotado: pagar el internet, antes del 25.\"}\\n\\nUsuario: \"ya fui al gym hoy\"\\n{\"intent\":\"registrar_habito\",\"data\":{\"nombre\":\"Gym\",\"hecho\":true},\"reply\":\"Gym marcado hoy. Vamos bien.\"}\\n\\nUsuario: \"abone 50 mil a rappi\"\\n{\"intent\":\"agregar_abono\",\"data\":{\"deuda\":\"Rappi\",\"monto\":50000},\"reply\":\"Abono de $50.000 registrado a Rappi.\"}\\n\\nUsuario: \"compre gasolina por 40k con la tarjeta\"\\n{\"intent\":\"agregar_compra\",\"data\":{\"deuda\":\"Rappi\",\"descripcion\":\"Gasolina\",\"monto\":40000},\"reply\":\"Compra de $40.000 en gasolina sumada a la deuda de Rappi.\"}\\n\\nUsuario: \"como voy este mes\"\\n{\"intent\":\"pedir_resumen\",\"data\":{\"tipo\":\"gastos\"},\"reply\":\"\"}\\n\\nUsuario: \"hola\"\\n{\"intent\":\"conversacion_libre\",\"data\":{},\"reply\":\"Hola Nico, en que te ayudo? Puedo anotar pendientes, marcar habitos, agendar cosas, o decirte como vas de plata.\"}';\nreturn [{ json: item }];"
      }
    },
    {
      "id": "d934dc81-4baa-4e29-8617-df5910af9b5d",
      "name": "Claude: clasificar intencion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        600
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 500, system: $json.systemPrompt, messages: [{ role: 'user', content: 'Fecha de hoy: ' + $json.fecha_hoy + '\\nMensaje: ' + $json.texto }] }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "id": "45471d55-d243-4c7e-92f2-71f5e3d2a60c",
      "name": "Parsear respuesta Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resp = $input.first().json;\nconst raw = (resp.content && resp.content[0] && resp.content[0].text) || '{}';\nlet text = raw.trim();\nif (text.startsWith('```')) {\n  text = text.replace(/^```(json)?/, '').replace(/```$/, '').trim();\n}\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch (e) {\n  parsed = { intent: 'conversacion_libre', data: {}, reply: 'No logre entender ese mensaje, me lo repites de otra forma?' };\n}\nconst from = $('Extraer mensaje').item.json.from;\nreturn [{ json: { intent: parsed.intent, data: parsed.data || {}, reply: parsed.reply || '', from } }];"
      }
    },
