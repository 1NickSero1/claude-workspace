    {
      "id": "f88c38c9-eb17-49a2-afff-f3a70a2e1ae5",
      "name": "Armar recordatorio semanal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().filter(r => (r.json.estado || '').toLowerCase() !== 'hecho');\n\nif (!rows.length) {\n  return [{ json: { mensaje: 'Buen inicio de semana, Nico. No tienes pendientes abiertos ahora mismo.' } }];\n}\n\nconst lineas = [`Pendientes de la semana (${rows.length}):`];\nfor (const r of rows) {\n  const venc = r.json.fecha_vencimiento ? ` (vence ${r.json.fecha_vencimiento})` : '';\n  lineas.push(`- ${r.json.descripcion}${venc}`);\n}\n\nreturn [{ json: { mensaje: lineas.join('\\n') } }];"
      }
    },
    {
      "id": "0d6f3d22-fb78-4076-9780-5830b3cabd0a",
