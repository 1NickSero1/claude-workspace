# Copia este archivo a .env en el VPS y completa los valores reales.
# No subas el .env real a git.

# Subdominio tuyo que apunta a la IP del VPS (registro A en tu proveedor de DNS)
N8N_HOST=n8n.tudominio.com

# Usuario/clave para entrar al panel de n8n (protege /login mientras trabajas)
N8N_BASIC_AUTH_USER=nico
N8N_BASIC_AUTH_PASSWORD=cambia-esto-por-algo-seguro
