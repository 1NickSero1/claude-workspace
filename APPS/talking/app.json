{
  "expo": {
    "name": "talking",
    "slug": "talking",
    "scheme": "talking",
    "owner": "nicksero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talking.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "TALKING necesita reconocimiento de voz para transcribir lo que dices en inglés.",
        "NSMicrophoneUsageDescription": "TALKING necesita el micrófono para escucharte practicar inglés."
      }
    },
    "android": {
      "package": "com.talking.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TALKING necesita el micrófono para escucharte practicar inglés.",
          "speechRecognitionPermission": "TALKING necesita reconocimiento de voz para transcribir lo que dices en inglés."
        }
      ],
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c157219e-71aa-46cf-ae0c-6cdda17a8b85"
      }
    }
  }
}
